# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# LINEログイン時のセッション発行と通知対象の抽出に使用（RLSをバイパスする強力なキー。公開厳禁）
SUPABASE_SERVICE_ROLE_KEY=

# サイトのURL（末尾スラッシュなし）。LINEのコールバックURLと完全一致させる
NEXT_PUBLIC_SITE_URL=

# LINEログインチャネル（連携・ログイン用）
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Messaging APIチャネル（通知送信・Webhook用）※LINEログインと同一プロバイダーに置くこと
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
LINE_MESSAGING_CHANNEL_SECRET=

# 日次ダイジェスト配信（Vercel Cron）の認証用。16文字以上のランダム文字列
CRON_SECRET=

# 通知メール（クエストの審査結果）の送信。Resend の API キー
# ※ Supabase のカスタムSMTPに使っているキーとは別に発行すること
RESEND_API_KEY=
# 差出人。Resend で認証済みのドメインのアドレスにすること
# 例: 九大ギルド <no-reply@send.example.org>
MAIL_FROM=
# 返信先（任意）。未設定なら返信先は差出人と同じになる
MAIL_REPLY_TO=
